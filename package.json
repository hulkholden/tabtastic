{
  "name": "tabtastic",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.3.14",
  "engines": {
    "bun": ">=1.3.14"
  },
  "scripts": {
    "build": "bun scripts/build.js",
    "test": "bun test ./tests",
    "test:browser": "bun scripts/test-browser.js",
    "dev": "bun scripts/serve.js",
    "lint": "bun run --bun eslint . --max-warnings=0",
    "lint:fix": "bun run --bun eslint . --fix --max-warnings=0",
    "format": "bun run --bun prettier . --write",
    "format:check": "bun run --bun prettier . --check",
    "check": "bun run lint && bun run format:check"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@stylistic/eslint-plugin": "^5.10.0",
    "eslint": "^10.12.0",
    "globals": "^17.13.0",
    "prettier": "^3.9.9"
  }
}
