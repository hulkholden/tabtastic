{
  "manifest_version": 3,
  "name": "Tabtastic",
  "version": "0.1.0",
  "description": "A calmer new tab. Find, organise, and move your open tabs, windows, and groups.",
  "minimum_chrome_version": "102",
  "permissions": ["tabs", "tabGroups", "storage", "favicon"],
  "optional_host_permissions": ["https://github.com/*"],
  "chrome_url_overrides": { "newtab": "index.html" },
  "action": { "default_title": "Open Tabtastic" },
  "icons": {
    "16": "assets/icon-16.png",
    "32": "assets/icon-32.png",
    "48": "assets/icon-48.png",
    "128": "assets/icon-128.png"
  },
  "background": { "service_worker": "background.js", "type": "module" },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'none'; img-src 'self' data: chrome-extension:;"
  }
}
